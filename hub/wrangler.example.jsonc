// Copy to wrangler.jsonc, then: npx wrangler deploy
// Secrets: npx wrangler secret put OWNER_KEY   (any long random string — your master link)
//          npx wrangler secret put CI_KEY      (only if you use the GitHub Action claim check)
{
  "name": "planboard-hub",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node build.mjs" },
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }]
}
